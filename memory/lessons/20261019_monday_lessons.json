 "new_lessons": [
  {
   "id": "L226",
   "title": "大小球档位整体压得太低",
   "evidence": "8场实际总进球4/3/3/3/4/2/3/2，全部2-4球；赛前只有006/008判小球命中，其余6场全部小球/闷战，六档2/8。",
   "action": "规则74硬化：λ_total≥2.2时，单轮不得全部落小球/闷战，至少2场落常规正常球(2-3)或以上；总进球TOP2至少含3球。"
  },
  {
   "id": "L227",
   "title": "主场热门集体翻车，规则79对主场/排名差加权过重",
   "evidence": "001蒙扎4-0、002代格福什1-2、003帕尔马0-3、007布拉加1-2；四场模型均给主胜/平，三场客胜+一场主队大胜；008/006次选平命中，方向4/8。",
   "action": "规则79加市场对照阀：模型主胜≥40%但市场同向<30%时，方向次选强制取市场方向；客队有保级/反击信号时，TOP5必须含客队净胜2球以上比分。"
  },
  {
   "id": "L228",
   "title": "让球首选3/8：无条件净胜球众数0→让负再次失败",
   "evidence": "001/005实际让胜、003/004实际让负，首选分别为让负/让负/让胜/让胜，四场错三场；008/006/007让负首选命中，让球合并4/8、首选3/8。",
   "action": "规则52a改口径：让球首选按k_rec方向+净胜球带；k_rec=+1且主胜概率≥40%时，让平/让胜必须进首选，禁止把让负当默认。"
  },
  {
   "id": "L229",
