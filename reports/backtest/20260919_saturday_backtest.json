 "key_lessons": [
  {
   "id": "L140",
   "title": "平局次选机制（最高优先级）",
   "detail": "实际平局9/30(30%)高于市场24%与模型27%，但仅3场被首选+次选覆盖；6场漏掉平局的场次中002/020/024的次选方向概率与平局概率差<3pp。建议：平局概率与当前次选方向概率差<3pp时，次选强制改为平局。回溯本轮可补回3场，方向命中率66.7%→76.7%。"
  },
  {
   "id": "L141",
   "title": "让球端双层修正：首选取最高概率 + 次选执行防对冲规则（合规修正，净收益0）",
   "detail": "首选层：让平作首选8场2中(25%) vs 非让平22场11中(50%)，应停止让平作首选。次选层：19场首选/次选为让胜vs让负对立，违反防对冲规则。**实测修正 +5/−5=净0，命中率仍70.0%（初版误写86.7%，漏计004/025/026/027/030五场失守）**。修正方案：让平只进次选、首选取方向内最高概率；次选强制执行防对冲规则。"
  },
  {
   "id": "L142",
   "title": "λ总向下校准 + 大球上修改止损型",
   "detail": "模型场均λ总3.24 vs 实际2.90，高估10.5%；上修生效13场实际场均2.92球 vs 未上修17场2.88球，差0.04球，上修未产生正向贡献。建议λ总施加-0.2~-0.3保守校准，上修仅在身价差≥3倍或对手客场场均失球≥2.5球时启用。"
  },
  {
   "id": "L143",
   "title": "双轨制定位重整",
   "detail": "「众数一致」8场众数命中率25.0%，「分布-方向分歧」22场27.3%——一致组反而略低；带内候选一致组25.0% vs 全样本23.3%。双轨制的价值是「一致性约束」而非命中率信号，应停止把「一致」当作更高胜率的隐含假设，比分串准入改回「方向概率≥50%＋带内候选≥3个」。"
  },
  {
   "id": "L144",
   "title": "高置信度场次双保险表达",
   "detail": "本轮唯一★★★场次021五项全失（0-1负垫底队，86分钟进球被VAR吹掉）。分层单调性成立（★★80% > ★66.7% > ☆50%），但最高层单点失效。建议★★★场次在报告中标注「方向可行，建议首选+次选双保险表达」，不作为单场重注依据。"
  },
  {
   "id": "L145",
   "title": "深盘场：方向可用、让球谨慎",
   "detail": "3场±2深盘的方向判断3/3全对（70%+的概率兑现），但净胜球数量级仅1/3正确，深盘让平首选1/3，且2场出现「主队未能净胜2球以上」。深盘的价值在方向不在让球，让球端应优先「让平+让负」双选而非单选让平。"
  }
 ],
